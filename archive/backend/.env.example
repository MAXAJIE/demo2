# CoreSite backend configuration
# SQLite is used for the demo. Point this at Postgres in production.
DATABASE_URL=sqlite:///./data/coresite.db

# Tenant served when the hostname is localhost / 127.0.0.1 and no ?tenant= is given.
DEFAULT_TENANT_SLUG=setapak-dental-jb

# Comma-separated origins allowed to call the API during local frontend dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long an admin session stays valid (hours).
ADMIN_SESSION_HOURS=12

# Seconds allowed for forwarding a lead / booking to a merchant webhook.
FORWARD_TIMEOUT_SECONDS=6

# booking lead time
BOOKING_LEAD_MINUTES=60

# Public form rate limit (per IP, per form type).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=10

# "production" refuses to seed the demo staff password. Anything else is local dev.
APP_ENV=development
# Required when APP_ENV=production (10+ characters). Used once, for the first staff login.
ADMIN_BOOTSTRAP_PASSWORD=

# Booking requests are limited more tightly than enquiries (per client IP).
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_WINDOW_MINUTES=60

# Behind a reverse proxy / Cloudflare, start uvicorn with:
#   uvicorn app.main:app --proxy-headers --forwarded-allow-ips=<proxy ip(s)>
# The rate limiter keys on request.client.host and ignores X-Forwarded-For itself.
